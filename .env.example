# 예제 값이며 실제 .env는 커밋하지 않습니다.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8085
DB_URL=jdbc:postgresql://localhost:5433/orders_query
DB_USERNAME=orders_query
DB_PASSWORD=replace-with-generated-query-password
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=stockdrop-api
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
SERVICE_HOSTNAME=localhost
SERVICE_PORT=8085
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
ORDER_QUERY_EVENTS_ENABLED=false
ORDER_QUERY_CONSUMER_GROUP=order-query-v1
